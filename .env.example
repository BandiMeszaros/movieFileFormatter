GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-3.8-flash
POLL_INTERVAL_SECONDS=60
MIN_VERIFICATION_CONFIDENCE=0.6
SUBTITLE_EXTENSIONS=srt,sub,ass,ssa,vtt,idx
# Host folders are set as bind mounts in docker-compose.yaml (Coolify: Storages
# tab). Don't set DOWNLOAD_DIR, MOVIE_OUTPUT or STATE_DIR to host paths: they
# are paths inside the container, and a STATE_DIR outside the /state mount
# loses the processed list on every redeploy.
